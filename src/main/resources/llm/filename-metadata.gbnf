# Constrains the local model to the exact line format LlmResponseParser reads
# (see FilenameParserService.SYSTEM_PROMPT). Year, season and episode may be left
# empty so the model is never forced to invent them — an incomplete show still
# triggers the folder-name fallback and the "missing season or episode" error.

root    ::= movie | show | error

movie   ::= "type: movie" name year
show    ::= "type: show" name year season episode
error   ::= "error: " [^\n]{1,200}

name    ::= "\nname: " [^ \n] [^\n]{0,119}
year    ::= "\nyear:" " "? ([12] [0-9]{3})?
season  ::= "\nseason:" " "? ("S" [0-9]{1,3})?
episode ::= "\nepisode:" " "? ("E" [0-9]{1,4})?
